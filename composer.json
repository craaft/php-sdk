{
    "name": "craaft/craaft",
    "description": "PHP client for the Craaft API.",
    "type": "library",
    "license": "MIT",
    "keywords": ["craaft", "api", "sdk", "client"],
    "authors": [
        { "name": "Sean Nieuwoudt", "email": "sean@underwulf.com" }
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Craaft\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Craaft\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
